# --- Server ---
PORT=4000
NODE_ENV=development
# Public URL of the Next.js frontend (used in Telegram links and CORS)
FRONTEND_URL=http://localhost:3001

# --- PostgreSQL ---
# The database is created for you by `npm run db:setup` if it does not exist.
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/phsaline

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- Telegram ---
# Each store connects its OWN bot from the seller portal (create one per store with @BotFather).
# Tokens are encrypted at rest with this key. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BOT_TOKEN_KEY=

# --- KHQR ---
# mock = simulated gateway with a "simulate payment" endpoint (development only)
KHQR_MODE=mock
# Shared secret the real gateway must send in the x-khqr-signature header of its webhook
KHQR_WEBHOOK_SECRET=

# --- Seed data ---
# Password given to every demo account created by `npm run db:seed`
SEED_PASSWORD=
